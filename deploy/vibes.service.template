[Unit]
Description=${SERVICE_NAME} Relay
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=${SERVICE_USER}
WorkingDirectory=${DEPLOY_PATH}/server
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
Environment=HOST=${SERVICE_HOST}
Environment=PORT=${SERVICE_PORT}
Environment=NODE_ENV=production
Environment=VIBES_DB_PATH=${DEPLOY_PATH}/data/vibes.sqlite
MemoryMax=512M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

server {
    listen 80;
    server_name ${DEPLOY_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DEPLOY_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DEPLOY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DEPLOY_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 2m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # Content-Security-Policy is owned by the SvelteKit app (hashed inline
    # scripts), so the proxy does not send a conflicting header.

    # Sparkle auto-update channel and Mac release downloads. Static files are
    # served straight from disk in ${DEPLOY_PATH}/releases — outside
    # ${DEPLOY_PATH}/server, so relay deploys never touch release artifacts.
    location = /appcast.xml {
        alias ${DEPLOY_PATH}/releases/appcast.xml;
        default_type application/xml;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location = /downloads/Vibes.dmg {
        alias ${DEPLOY_PATH}/releases/downloads/Vibes.dmg;
        default_type application/x-apple-diskimage;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location = /downloads/SHA256SUMS {
        alias ${DEPLOY_PATH}/releases/downloads/SHA256SUMS;
        default_type text/plain;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location = /downloads/latest.json {
        alias ${DEPLOY_PATH}/releases/downloads/latest.json;
        default_type application/json;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location /downloads/ {
        alias ${DEPLOY_PATH}/releases/downloads/;
        autoindex off;
        types {
            application/x-apple-diskimage dmg;
            application/zip zip;
            text/plain txt;
            application/json json;
        }
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://${SERVICE_HOST}:${SERVICE_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

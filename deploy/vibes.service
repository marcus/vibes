[Unit]
Description=Vibes Relay
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/vibes/server
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
Environment=HOST=127.0.0.1
Environment=PORT=3136
Environment=NODE_ENV=production
Environment=VIBES_DB_PATH=/var/www/vibes/data/vibes.sqlite
MemoryMax=512M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

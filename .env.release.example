# Release configuration for scripts/release-mac.sh and scripts/generate-appcast.sh.
# Copy to .env.release and fill in. .env.release is gitignored — never commit it.

# Reverse-DNS app id for the public, update-capable build. Set in the Xcode
# project (PRODUCT_BUNDLE_IDENTIFIER); this must match it.
VIBES_BUNDLE_ID="com.opentangle.vibes"

# Apple Developer Team ID (10 chars) that owns the Developer ID Application cert.
VIBES_DEVELOPMENT_TEAM="H5G3VW27DZ"

# Full Developer ID Application identity string, exactly as `security
# find-identity -v -p codesigning` prints it.
VIBES_CODESIGN_IDENTITY="Developer ID Application: Marcus Vorwaller (H5G3VW27DZ)"

# notarytool keychain profile name created by scripts/setup-notary.sh.
VIBES_NOTARY_PROFILE="vibes-notary"

# Version being released. VIBES_RELEASE_VERSION must equal the project's
# MARKETING_VERSION; VIBES_BUILD_NUMBER must exceed the last released build.
VIBES_RELEASE_VERSION="0.2.0"
VIBES_BUILD_NUMBER="2"

# Public self-hosted downloads prefix where update archives and first-download
# artifacts are served (no trailing slash). scripts/publish-mac-release.sh
# publishes /downloads/latest.json from this release env; do not edit that
# generated manifest manually.
VIBES_APPCAST_BASE_URL="https://vibes.opentangle.com/downloads"

# Build + notarize the self-hosted first-download DMG by default.
VIBES_BUILD_DMG="1"

# Optional: path to an unpacked Sparkle release's bin/ dir, for generate_appcast.
# SPARKLE_BIN="/path/to/Sparkle/bin"

# Optional: private EdDSA key file for non-interactive appcast signing (CI /
# headless). Export once with `generate_keys -x <file>`. Leave unset to sign
# from the Keychain (approve the macOS prompt the first time). Never commit this.
# VIBES_ED_KEY_FILE="/secure/path/vibes-ed25519.key"

# Release configuration for scripts/release-mac.sh and scripts/generate-appcast.sh.
# Copy to .env.release and fill in. .env.release is gitignored — never commit it.

# Reverse-DNS app id for the public, update-capable build.
# Replace the placeholder com.example.vibes in the Xcode project too.
VIBES_BUNDLE_ID="app.vibes.mac"

# Apple Developer Team ID (10 chars). Detected locally as J23CYSN68B — confirm
# this is the team that owns the Developer ID Application certificate.
VIBES_DEVELOPMENT_TEAM="J23CYSN68B"

# Full Developer ID Application identity string, exactly as `security
# find-identity -v -p codesigning` prints it once the cert is installed.
VIBES_CODESIGN_IDENTITY="Developer ID Application: Marcus Vorwaller (J23CYSN68B)"

# notarytool keychain profile name created by scripts/setup-notary.sh.
VIBES_NOTARY_PROFILE="vibes-notary"

# Version being released. VIBES_RELEASE_VERSION must equal the project's
# MARKETING_VERSION; VIBES_BUILD_NUMBER must exceed the last released build.
VIBES_RELEASE_VERSION="0.2.0"
VIBES_BUILD_NUMBER="2"

# Public URL prefix where update archives are downloadable (no trailing slash),
# e.g. a GitHub Releases download base or https://vibes.<domain>/downloads.
VIBES_APPCAST_BASE_URL="https://github.com/<owner>/<repo>/releases/download/v0.2.0"

# Set to 1 to also build + notarize a first-download DMG.
VIBES_BUILD_DMG="0"

# Optional: path to an unpacked Sparkle release's bin/ dir, for generate_appcast.
# SPARKLE_BIN="/path/to/Sparkle/bin"
